    <string name="help_configuration"><![CDATA[<h4>Configurazione</h4>La posizione, il fuso orario e le altre opzioni sono configurati da Suntimes.]]></string>
    <string name="help_rating_day"><![CDATA[<h4>Valutazione solunar</h4>I giorni <b>eccellenti</b> si verificano durante la <em>luna nuova</em> e la <em>luna piena</em>, con giorni <b>buoni</b> e <b>ottimi</b> prima e dopo questi eventi.]]></string>
    <string name="help_minor_periods"><![CDATA[I periodi <b>minori</b> si verificano all'<em>alba lunare</em> e al <em>tramonto lunare</em> e durano generalmente un'ora.]]></string>
    <string name="help_major_periods"><![CDATA[I periodi <b>maggiori</b> si verificano a <em>mezzogiorno lunare</em> e a <em>mezzanotte lunare</em> e durano generalmente 2 ore.]]></string>
    <string name="help_rating_period"><![CDATA[<b>&#x2299;</b> Un periodo è potenziato quando si verifica entro 30 minuti dall'<em>alba</em> o dal <em>tramonto</em>.]]></string>
